# Secrets
.env

# Claude Code local config
.claude/

# User-generated prompts (cached locally, not committed)
prompts/

# Local examples / scratch deliverables (offline transfer packages, handoffs)
examples/

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/

# Temp files
*.tmp

# Asset toolchain (mermaid-cli + mathjax-full are dev-only; generated SVGs are committed)
docs/assets/node_modules/
docs/assets/package-lock.json
docs/assets/package.json

# state/ is runtime + scratch. A concurrent session owns this dir.
# Precedent seed now lives inside the inference-engine plugin
# (plugins/inference-engine/state/artifacts.jsonl via backfill — see OP06).
# Nothing here ships.
state/

# Efficacy harness raw transcripts (verdict.json is the durable artifact).
# Redundant under the blanket state/ rule above, but kept explicit per the
# v0 efficacy-sandbox proposal (state/efficacy/<slug>/runs/).
state/efficacy/*/runs/

# Eval-corpus measure outputs are transient — corpus.json is the committed
# artifact; runs/ raw transcripts and the last-run verdict.json regenerate on
# every `efficacy-replay.py corpus` invocation.
shared/eval-corpus/*/runs/
shared/eval-corpus/*/verdict.json

# Research workspace. Same class as state/: scratch, runs, logs, frozen
# snapshots, and cloned upstream corpora (repos_src/, lava-src/). The durable
# artifacts are the write-ups (FINAL.md, claims.json), which get promoted to
# docs/ when they ship. Nothing here is committed.
.research/

# Convergence engine test output — regenerated by shared/scripts/convergence.py
tests/convergence-engine/learnings.json
tests/convergence-engine/learnings.md

# pytest cache
.pytest_cache/

# Windows null-device artifact: `> NUL` under a POSIX shell creates a real file
NUL

# vis package materialization cache (WIX-INSTALL-002 / D8). Generated by
# scripts/bootstrap.sh / bootstrap.ps1 from the pinned (or, with --floating,
# live) vis sibling; CLAUDE.md's @.vis-cache/vis/... imports resolve here.
# Never committed — .vis-lock is the durable, reviewable record of what was
# materialized.
.vis-cache/
